# Copy this file to `.env` (start_jarvis.sh does it for you) and fill in your values.
# Lines starting with # are ignored. Leave a value empty to use the default.

# --- ElevenLabs voice (required for the spoken welcome) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- What Jarvis says after the double clap ---
JARVIS_WELCOME_PHRASE=Welcome home, sir. All systems are online.

# --- Music (Spotify link or YouTube link) ---
JARVIS_SONG_URI=https://open.spotify.com/track/39shmbIHICJ2Wxnk1fPSdz
# Audio ducking (Spotify's own volume, 0-100; your Mac's volume is never changed):
# the song starts at full volume, ducks under the voice (still audible), then rises again.
# Seconds the song plays at full volume before ducking.
JARVIS_MUSIC_LEAD_IN_SECONDS=0.3
# Volume while the voice speaks, and how long the duck takes (the voice starts after it).
JARVIS_SPOTIFY_DUCK_VOLUME=35
JARVIS_SPOTIFY_DUCK_FADE_SECONDS=0.5
# Full volume if your previous Spotify volume is unknown or not above the duck volume.
JARVIS_SPOTIFY_NORMAL_VOLUME=65
# true = full volume is the Spotify volume you had before; false = always use NORMAL above.
JARVIS_SPOTIFY_RESTORE_PREVIOUS=true
# Seconds for the rise back to full volume after the voice.
JARVIS_SPOTIFY_FADE_SECONDS=2.0

# --- Websites opened in Google Chrome ---
CLAUDE_CODE_URL=https://claude.ai/new
TASARADAR_URL=https://tasaradar.com
# Which display each window goes to (1 = leftmost). With one screen, both use it.
CLAUDE_CHROME_MONITOR=1
TASARADAR_CHROME_MONITOR=3
# true = macOS fullscreen, false = normal window
OPEN_CHROME_FULLSCREEN=true

# --- Cursor ---
CURSOR_OPEN_FULLSCREEN=true

# --- Clap sensitivity (leave empty for the defaults) ---
# Quietest accepted clap peak (default 0.15).
JARVIS_MIN_CLAP_PEAK=
# Least energy (rms) a clap may have (default 0.3; real MacBook claps measure 1.1-2.3).
# Raise if clicks/typing trigger Jarvis, lower if your claps show "too little energy".
JARVIS_MIN_CLAP_RMS=
# How many times louder than the room a clap must be (default 5).
JARVIS_SPIKE_RATIO=

# --- Microphone (only if the wrong mic is picked; name or number) ---
JARVIS_INPUT_DEVICE=
